<div class="calendar overflow-x-auto">
  <table class="table table-fixed">
    <thead>
      <tr>
        <th></th>
        <% date_range.slice(0, 6).each do |day| %>
          <th style="width: 160px;">
            <p class="text-base text-neutral"><%= l(day, format: :short) %></p>
            <% if @salle %>
              <% if Ouverture.where(bloc: @salle.bloc, jour: day.wday).any? %>
                <% if ouverture = Ouverture.where(jour: day.wday).find_by(bloc: @salle.bloc) %>
                  <p class="text-success font-normal">
                    <%= ouverture.horaires %>
                  </p>
                <% end %>
              <% end %>
            <% end %>
          </th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% date_range.each_slice(7) do |week| %>
        <tr>
          <td class="align-top">
            <% if @salle %>
              <p id=<%= @salle.nom %> class="text-xl text-center break-words">
                <b><%= @salle.nom %></b>
                <br>
                <small>(<%= @salle.places %>)</small>
              </p>
            <% else %>
              <span>À BOOKER</span>
            <% end %>
          </td>
          
          <% nom_jumelle = @salle&.nom_salle_fusionnée %>

          <% week.each do |day| %>
            <% unless day.sunday? %>
              <% day_style_class = 'shadow bg-amber-100' if day == Date.today %>
              <% day_style_class = 'shadow bg-red-100' if Fermeture.find_by(date: day) %>

              <%# Fusion : cette salle a un cours fusion ce jour, OU sa salle jumelée en a un %>
              <% fusion_ce_jour = sorted_events.fetch(day, []).any? { |cour| cour.options.any?(&:fusion?) } %>
              <% fusion_ce_jour ||= nom_jumelle.present? &&
                  Cour.joins(:salle, :options)
                      .where(salles: { nom: nom_jumelle })
                      .where(options: { catégorie: :fusion })
                      .where("DATE(cours.debut) = ?", day).exists? %>
              <% day_style_class = 'shadow bg-[repeating-linear-gradient(-45deg,transparent_0_20px,rgb(251_146_60/0.4)_20px_40px)]' if fusion_ce_jour %>

              <%= content_tag :td, class: "align-top p-3 #{day_style_class}" do %>
                <% passed_block.call day, sorted_events.fetch(day, []) %>
              <% end %>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
