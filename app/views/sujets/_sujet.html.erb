<tr class="hover border">
  <td>
    il y a <%= time_ago_in_words sujet.updated_at %>
  </td>
  <td>
    <% if sujet.cour.debut > DateTime.now %>
      <small>(dans <%= time_ago_in_words(sujet.cour.debut) %>)</small>
      <br>
    <% end %>
    <%= link_to l(sujet.cour.debut, format: :long), cours_path(start_date: sujet.cour.debut.to_date, intervenant_id: sujet.cour.intervenant_binome_id, formation_id: sujet.cour.formation_id), class: 'text-primary hover:underline' %>

  </td>
  <% if params[:action] == 'index' && params[:controller] == 'sujets' && !@imprimeur %>
    <td>
      <%= link_to sujet.cour.intervenant_binome&.nom_prenom, sujet.cour.intervenant_binome, class: 'text-primary hover:underline' %>
    </td>
  <% end %>
  <td style="border-left: .3rem solid <%= sujet.cour.formation.positive_color %>">
    <% if policy(Formation).show? %>
      <% sujet.formations.each do |formation| %>
        <%= link_to formation.nom_nbr_etudiants, formation, class: 'text-primary hover:underline' %>
      <% end %>
    <% else %>
      <% sujet.formations.each do |formation| %>
        <%= formation.nom %>
      <% end %>
    <% end %>
  </td>
  <td>
    <span class="badge badge-lg <%= sujet.style %> text-white">
      <%= sujet.workflow_state.humanize %>
    </span>
  </td>
  <% if @imprimeur %>
    <td style="text-align: center">
      <%= sujet.nbr_copies_avec_ajout %>
    </td>
    <td>
      <% if sujet.sujet.attached? %>
        <% if current_user.otp_required_for_login %>
          <% if sujet.sujet.representable? %>
            <%= image_tag(sujet.sujet.representation(resize_to_limit: [150, 150]), title: sujet.sujet.filename, class: 'shadow') %>
          <% end %>
        <% else %>
          <%= link_to "Activer la double authentification", user_path(current_user), class: "text-primary hover:underline font-black" %>
          pour voir l'aperçu du document
        <% end %>
      <% end %>
    </td>
    <td>
      <% if sujet.sujet.attached? && current_user.otp_required_for_login %>
        <%= link_to imprimer_sujet_path(sujet), title: "Télécharger le sujet", 'data-turbo': false do %>
          <span class="material-symbols-outlined text-3xl text-error">picture_as_pdf</span>
        <% end %>
      <% else %>
        <%= link_to "Activer la double authentification", user_path(current_user), class: "text-primary hover:underline font-black" %>
        pour télécharger le document
      <% end %>
    </td>
  <% elsif params[:action] == 'index' && params[:controller] == 'sujets' %>
    <% if sujet.mail_log %>
      <% if sujet.mail_log.statut %>
        <td style="text-align: center">
          <span class="text-success">OK</span>
        </td>
        <td style="text-align: center">
          <% if sujet.mail_log&.opened %>
            <span class="text-info">Oui</span>
          <% else %>
            <span class="text-info">Non</span>
          <% end %>
        </td>
      <% else %>
        <td style="text-align: center">
          <span class="text-error">KO</span>
        </td>
        <td></td>
      <% end %>
    <% else %>
      <td></td>
      <td></td>
    <% end %>
  <% end %>
  <% unless @imprimeur %>
    <td><%= link_to 'Voir', sujet, class: 'text-primary hover:underline', 'data-turbo': false %></td>
  <% end %>
  <% if current_user.intervenant? %>
    <td>
      <% if policy(sujet).edit? %>
        <%= link_to 'Modifier', edit_sujet_path(sujet), class: 'text-primary hover:underline', 'data-turbo': false %>
      <% end %>
    </td>
  <% end %>
</tr>
